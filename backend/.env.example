DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=resume_builder
DATABASE_PASSWORD=resume_builder

# OpenRouter (https://openrouter.ai) — required for chat enhancements
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Comma-separated browser origins allowed to call the API (CORS)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional override for JWT signing (defaults to Rails secret_key_base)
# JWT_SECRET=

# Google Sign-In (OAuth client ID — Web application type)
GOOGLE_CLIENT_ID=

# Comma-separated admin emails (read-only /admin panel via JWT)
ADMIN_EMAILS=you@example.com

# Public API host used for Active Storage photo URLs in production
# API_HOST=forge-resume-api.onrender.com
# API_PROTOCOL=https
# API_PORT=443
