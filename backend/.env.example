DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=resume_builder
DATABASE_PASSWORD=resume_builder

# OpenRouter (https://openrouter.ai) — required for chat enhancements
OPENROUTER_API_KEY=your-openrouter-api-key-here
